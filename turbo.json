{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalDependencies": [".env", "docker/postgres/init/**"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "!.next/dev/**", "!.next/standalone/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "interruptible": true
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": [
        "CI",
        "DATABASE_URL",
        "DATABASE_MIGRATE_URL",
        "REDIS_URL",
        "TEST_DATABASE_URL",
        "TEST_DATABASE_MIGRATE_URL",
        "TEST_REDIS_URL",
        "TEST_DISPUTE_WINDOW_SECONDS",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "WEB_ORIGIN",
        "SMTP_HOST",
        "SMTP_PORT",
        "SMTP_FROM"
      ]
    },
    "db:generate": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["DATABASE_URL", "DATABASE_MIGRATE_URL"]
    },
    "db:migrate": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["DATABASE_URL", "DATABASE_MIGRATE_URL"]
    },
    "db:seed": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["DATABASE_URL", "SEED_ADMIN_EMAIL", "SEED_ADMIN_PASSWORD"]
    },
    "openapi:export": {
      "dependsOn": ["build"],
      "cache": false
    },
    "generate": {
      "cache": false,
      "passThroughEnv": ["OPENAPI_JSON"]
    }
  }
}
