{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "description": "buddha REST API (NestJS 12 + Fastify 5)",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "openapi:export": "node dist/openapi-export.js"
  },
  "dependencies": {
    "@buddha/db": "workspace:*",
    "@buddha/shared": "workspace:*",
    "@fastify/helmet": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-fastify": "catalog:",
    "@nestjs/platform-socket.io": "catalog:",
    "@nestjs/swagger": "catalog:",
    "@nestjs/throttler": "catalog:",
    "@nestjs/websockets": "catalog:",
    "@socket.io/redis-adapter": "catalog:",
    "@thallesp/nestjs-better-auth": "catalog:",
    "better-auth": "catalog:",
    "bullmq": "catalog:",
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:",
    "fastify": "catalog:",
    "ioredis": "catalog:",
    "nodemailer": "catalog:",
    "pino": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "socket.io": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@buddha/config-eslint": "workspace:*",
    "@buddha/config-ts": "workspace:*",
    "@nestjs/cli": "catalog:",
    "@nestjs/testing": "catalog:",
    "@standard-schema/spec": "catalog:",
    "@types/node": "catalog:",
    "@types/nodemailer": "catalog:",
    "eslint": "catalog:",
    "pino-pretty": "catalog:",
    "socket.io-client": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
