{
  "name": "worker",
  "version": "0.0.0",
  "private": true,
  "description": "BullMQ consumer: market close/finalize, ledger audit, stats",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "build": "tsc -b tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "job:ledger-audit": "tsx src/scripts/run-ledger-audit.ts"
  },
  "dependencies": {
    "@buddha/db": "workspace:*",
    "@buddha/shared": "workspace:*",
    "@buddha/storage": "workspace:*",
    "bullmq": "catalog:",
    "drizzle-orm": "catalog:",
    "ioredis": "catalog:",
    "pino": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@buddha/config-eslint": "workspace:*",
    "@buddha/config-ts": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "pino-pretty": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
