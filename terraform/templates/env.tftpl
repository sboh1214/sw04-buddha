# Rendered by Terraform (terraform/ssm.tf) into the SSM SecureString /tf-buddha/env and written to
# /data/buddha/.env by deploy/deploy.sh on every deploy. Never commit a rendered copy. deploy.sh
# appends IMAGE_TAG=<git sha> below this block. Values are consumed by deploy/compose.yaml
# (`$${VAR}` interpolation), by the api/worker/migrate containers and by postgres-init.
NODE_ENV=production

# --- deploy-time constants (compose interpolation + deploy.sh) ---
ECR_REGISTRY=${ecr_registry}
DOMAIN=${domain}
ACME_EMAIL=${acme_email}
LOG_LEVEL=${log_level}

# --- api (apps/api/src/config/env.ts) ---
API_HOST=0.0.0.0
API_PORT=4000
# Caddy's fixed compose address: the only hop allowed to set X-Forwarded-* (ADR-0034). Never true.
TRUST_PROXY=172.28.0.10/32
# web's fixed compose address: its SSR calls arrive through Caddy and must not share one bucket.
RATE_LIMIT_UNCOUNTED_PEERS=172.28.0.20/32
DATABASE_URL=postgres://buddha_app:${db_app_password}@postgres:5432/buddha
DATABASE_MIGRATE_URL=postgres://buddha_migrate:${db_migrate_password}@postgres:5432/buddha
REDIS_URL=redis://redis:6379
BETTER_AUTH_SECRET=${better_auth_secret}
BETTER_AUTH_URL=https://${domain}
WEB_ORIGIN=https://${domain}
# AUTH_COOKIE_DOMAIN stays unset: web and API share one hostname, the cookie is host-only.
SMTP_HOST=email-smtp.${region}.amazonaws.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=${smtp_user}
SMTP_PASS=${smtp_pass}
SMTP_FROM=${smtp_from}
GOOGLE_CLIENT_ID=${google_client_id}
GOOGLE_CLIENT_SECRET=${google_client_secret}
KAKAO_CLIENT_ID=${kakao_client_id}
KAKAO_CLIENT_SECRET=${kakao_client_secret}
NAVER_CLIENT_ID=${naver_client_id}
NAVER_CLIENT_SECRET=${naver_client_secret}
# No PAYMENT_PROVIDER: deploy/compose.yaml passes the one provider, mock, itself (ADR-0049).
# SMS for 본인확인 (ADR-0070): always aligo here. Empty keys boot the API, and then every code send
# fails (SMS_SEND_FAILED), so no account can verify until they are set (ADR-0069 decision 4 #183).
SMS_PROVIDER=aligo
ALIGO_API_KEY=${aligo_api_key}
ALIGO_USER_ID=${aligo_user_id}
ALIGO_SENDER=${aligo_sender}
ALIGO_TEST_MODE=${aligo_test_mode}
# The keyed hash of a verified number (ADR-0071). Generated once (ssm.tf); never rotate it: every
# number that got its start Coin would get it again on its next account.
PHONE_HASH_KEY=${phone_hash_key}
# The private bucket of the post images (media.tf, ADR-0073), read and written by the api and the
# worker only, with the media IAM user's key (not the instance role: the IMDS hop limit stays 1).
# MEDIA_STORAGE needs no line: deploy/compose.yaml passes s3 to both.
MEDIA_S3_BUCKET=${media_s3_bucket}
MEDIA_S3_REGION=${region}
MEDIA_S3_ACCESS_KEY_ID=${media_s3_access_key_id}
MEDIA_S3_SECRET_ACCESS_KEY=${media_s3_secret_access_key}

# --- postgres init (deploy/postgres-init/02-passwords.sh) + seed (packages/db/dist/seed.js) ---
POSTGRES_PASSWORD=${postgres_password}
BUDDHA_APP_PASSWORD=${db_app_password}
BUDDHA_MIGRATE_PASSWORD=${db_migrate_password}
SEED_ADMIN_EMAIL=${seed_admin_email}
SEED_ADMIN_PASSWORD=${seed_admin_password}
SEED_SECOND_ADMIN_EMAIL=${seed_second_admin_email}
SEED_SECOND_ADMIN_PASSWORD=${seed_second_admin_password}
