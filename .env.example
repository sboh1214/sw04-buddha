# Copy to .env (never commit .env). One root file is shared by apps/api, apps/worker, apps/web
# and packages/db: each process loads it itself (Turborepo does not). Values match docker/.
NODE_ENV=development

# --- Database (docker/postgres/init/01-roles.sql creates both roles) ---
# Runtime role: DML only (PLAN 6.4 restricts ledger_entries/market_events/admin_actions to INSERT/SELECT).
DATABASE_URL=postgres://buddha_app:buddha@localhost:5432/buddha
# Migration role: owns the schema, used only by `pnpm db:migrate` / drizzle-kit.
DATABASE_MIGRATE_URL=postgres://buddha_migrate:buddha@localhost:5432/buddha
# Integration tests (docker compose --profile test up -d postgres-test redis-test), PLAN 14.
# Test suites read ONLY these TEST_* keys (never DATABASE_URL) so they can never touch the
# dev database; DB-backed suites are skipped when they are unset (fail when CI=true).
# CI points them at its own service containers instead (.github/workflows/ci.yml).
TEST_DATABASE_URL=postgres://buddha_app:buddha@localhost:5433/buddha
TEST_DATABASE_MIGRATE_URL=postgres://buddha_migrate:buddha@localhost:5433/buddha
TEST_REDIS_URL=redis://localhost:6380

# --- Redis (BullMQ, Socket.IO adapter, rate limit, idempotency) ---
REDIS_URL=redis://localhost:6379

# --- better-auth (M1, PLAN 10) ---
# Required unless NODE_ENV=test; at least 32 characters in production.
# Generate a real value with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=change-me
# Public origin the browser uses (the web app). better-auth builds OAuth callback and email
# links from it: <BETTER_AUTH_URL>/api/auth/... is rewritten by Next.js to the API.
BETTER_AUTH_URL=http://localhost:3000
# Web origin(s) trusted by better-auth (CSRF, redirectTo/callbackURL) and allowed by CORS
# (ADR-0017). Comma-separated. Defaults to the origin of BETTER_AUTH_URL.
WEB_ORIGIN=http://localhost:3000
# Registrable domain the session cookie is scoped to, e.g. example.com when the web is
# app.example.com and the API is api.example.com. LEAVE EMPTY LOCALLY: localhost:3000 and
# localhost:4000 are the same host (a port is no part of a cookie's identity), and unset the
# cookie stays host-only, which is the safer default.
# Set it for any deployment that splits the two across hosts. The login cookie is minted
# through the WEB host (Next rewrites /api/auth/* server-side) while the socket dials the API
# host directly, and a cookie with no Domain goes back only to the exact host that set it — so
# without this every signed-in user gets an anonymous handshake and the balance chip and 내
# 포지션 stop updating with nothing logged (ADR-0017 추기).
# The cost: every subdomain of this domain receives the session cookie, so name only a domain
# whose subdomains are all yours. A bare hostname — not a URL, not a leading dot.
# The BETTER_AUTH_URL host must BE this domain or sit under it, or the API refuses to start:
# a browser drops a Set-Cookie whose Domain the setting host is not under, so uncommenting the
# line below while BETTER_AUTH_URL is still localhost is the silent-dead-session config itself.
# AUTH_COOKIE_DOMAIN=example.com

# --- OAuth providers (a provider is enabled only when BOTH of its keys are set) ---
# Redirect URI to register in each developer console (local):
#   http://localhost:3000/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/kakao
#   http://localhost:3000/api/auth/callback/naver
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- Email (Mailpit: SMTP 1025, UI http://localhost:8025; no auth, no TLS) ---
# Sign-up requires clicking the verification link (PLAN 17 Q1): locally it lands in Mailpit.
SMTP_HOST=localhost
SMTP_PORT=1025
# Bare address or `Name <address>`. With SES this must be a verified identity (domain with SPF/DKIM).
SMTP_FROM=noreply@buddha.local
# Production = AWS SES (PLAN 17 Q3): SMTP_HOST=email-smtp.<region>.amazonaws.com, SMTP_PORT=587,
# SMTP_SECURE=false (STARTTLS is enforced whenever credentials are set) or 465 + SMTP_SECURE=true,
# SMTP_USER/SMTP_PASS = the SES "SMTP credentials" of an IAM user. Both or neither.
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# --- Payments (ADR-0042, ADR-0049) ---
# Which provider takes NEW charges: mock (default: succeeds at once, no money moves; CI and e2e
# use it), the only one since the SmartroPay integration was removed (ADR-0049). Whatever this
# says, paid Coin stays closed in the initial product: that switch is PAID_COIN_SALES_ENABLED in
# @buddha/shared, a code change and a deploy rather than an env value.
PAYMENT_PROVIDER=mock

# --- SMS for 본인확인 (#183, ADR-0070) ---
# Who texts the six-digit verification codes: dev (texts nobody: each code is mailed to Mailpit as
# sms-<number>@sms.buddha.local, which is how local development and the e2e suite read it) or
# aligo (알리고). Left empty: dev, and aligo under NODE_ENV=production, which refuses dev.
SMS_PROVIDER=dev
# 알리고: the API key, its account id and the registered sender number (발신번호, digits). All three
# or none; aligo without them fails every send, so no account can complete the verification. The
# provider also takes sends only from the server addresses registered with it.
ALIGO_API_KEY=
ALIGO_USER_ID=
ALIGO_SENDER=
# true = 알리고 test mode (testmode_yn=Y): answered as usual, texted to nobody, not charged.
ALIGO_TEST_MODE=false

# --- Seed data (pnpm db:seed, runs as DATABASE_URL) ---
# Bootstrap admins (PLAN 10.5, #171): created only while no account holds the admin role — after
# that the seed creates and promotes nobody, and admins are granted and revoked on the admin
# screen. Passwords 8-128 chars; re-seeding never resets an existing password. The second is
# optional, but the two-person rule needs two distinct admins in every environment. Set each
# pair in full or not at all, and the second only with the first: anything else fails the seed
# before it writes.
SEED_ADMIN_EMAIL=admin@buddha.local
SEED_ADMIN_PASSWORD=admin1234!
SEED_SECOND_ADMIN_EMAIL=admin2@buddha.local
SEED_SECOND_ADMIN_PASSWORD=admin5678!

# --- Servers ---
# Bind address for the API. "localhost" (IPv4 + IPv6 loopback) keeps it off the LAN on a
# dev machine; containers set 0.0.0.0.
API_HOST=localhost
API_PORT=4000
# Proxies allowed to set X-Forwarded-* (comma-separated IPs/CIDRs, or true/false).
#
# Keep false unless a real reverse proxy that sets or appends the client IP fronts the API. Next's
# rewrite does set X-Forwarded-For, but as `client-supplied ?? socket address` (Next 16
# base-server.js uses ??=), so a caller can put anything there and trusting it would be worse
# than not having it. PLAN 7.5's per-address limit reads request.ip, so behind the rewrite it
# is skipped for peers that cannot name a client — loopback, and RATE_LIMIT_UNCOUNTED_PEERS
# below — rather than counting every visitor into one bucket (ADR-0034). What turns a
# per-visitor limit back on is a proxy AHEAD of the web server that routes /api/* straight to
# the API and appends the visitor to X-Forwarded-For, named here by its CIDR. Never `true`.
TRUST_PROXY=false
# Peers whose requests the per-address limit does NOT count: proxies in front of the API whose
# forwarding is not trusted (above) and which therefore cannot name a client — the web server's
# Next rewrite when it runs on another host or in another container. Comma-separated addresses
# or CIDRs, IPv4 or IPv6 (e.g. 172.18.0.0/16, fd00::/8); loopback is always one. Left empty on
# a split web/API deployment, every visitor is counted as the web host and the whole site shares
# one 100/min window. Refused at boot if an entry is not an address or CIDR.
RATE_LIMIT_UNCOUNTED_PEERS=
# apps/web rewrites /api/* to this origin (server-side) and its server components call
# <NEXT_PUBLIC_API_URL>/api/auth/get-session with the request cookies; api-client uses it
# on the server. Baked into the web build (rewrite destination). Since M4 the BROWSER also
# reads it: a Next rewrite does not proxy a WebSocket upgrade, so the Socket.IO client
# connects to <NEXT_PUBLIC_API_URL>/ws directly with credentials (ADR-0017). Web and API must
# therefore stay same-site for the SameSite=Lax session cookie to ride the handshake, and
# WEB_ORIGIN above must list the web origin: it is the CORS allow-list for that handshake.
# Same-site is NOT enough on its own once the two are different hosts — see AUTH_COOKIE_DOMAIN.
NEXT_PUBLIC_API_URL=http://localhost:4000
# apps/worker liveness probe: GET http://<WORKER_HOST>:<WORKER_HEALTH_PORT>/health answers 200
# once the queues are ready and Postgres has answered (503 while starting). Playwright and CI
# wait on it before the settlement e2e; a container health check can too. 0 disables the
# listener. Loopback only by default, like the API.
WORKER_HOST=localhost
WORKER_HEALTH_PORT=4100
# Optional log level for apps/api AND apps/worker: fatal|error|warn|info|debug|trace|silent
# (default: debug in development, info in production, silent under test). Both write pino JSON
# through the same configuration (ADR-0035); the API adds one line per completed request with
# its reqId, route, status and responseTime.
# LOG_LEVEL=debug
