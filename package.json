{
  "name": "buddha",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.10.0"
  },
  "scripts": {
    "dev": "turbo run dev --env-mode=loose",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "prettier --write . --cache",
    "format:check": "prettier --check . --cache",
    "db:generate": "turbo run db:generate --filter=@buddha/db",
    "db:migrate": "turbo run db:migrate --filter=@buddha/db",
    "db:seed": "turbo run db:seed --filter=@buddha/db",
    "api:openapi": "turbo run openapi:export --filter=api && turbo run generate --filter=@buddha/api-client",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "mobile:doctor": "pnpm --filter mobile run doctor",
    "ci": "turbo run lint typecheck test build"
  },
  "devDependencies": {
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
